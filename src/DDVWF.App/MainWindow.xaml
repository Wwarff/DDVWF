<Window x:Class="DDVWF.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Dragon's Den Visual WorldForge — INTEGRATION" Width="1600" Height="1000" Background="#111318" Foreground="#9CFF80">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File"><MenuItem Header="_Open Zone..." Click="OpenZone_Click"/><MenuItem Header="_Close Zone" Click="CloseZone_Click"/><Separator/><MenuItem Header="EQEmu _SQL..." Click="ServerSettings_Click"/><Separator/><MenuItem Header="E_xit" Click="Exit_Click"/></MenuItem>
      <MenuItem Header="_Edit"><MenuItem Header="_Undo" Click="Undo_Click"/><MenuItem Header="_Redo" Click="Redo_Click"/></MenuItem>
      <MenuItem Header="_View"><MenuItem Header="_Compass" Click="Compass_Click"/><Separator/><MenuItem Header="_Theme Editor" Click="ThemeEditor_Click"/><MenuItem Header="_Shortcuts" Click="Shortcuts_Click"/></MenuItem>
      <MenuItem Header="_Tools"><MenuItem Header="_Focus Selection" Click="Focus_Click"/></MenuItem><MenuItem Header="_World"><MenuItem Header="_Reload Active Zone" Click="ReloadZone_Click"/></MenuItem><MenuItem Header="_Navigation"><MenuItem Header="_Focus Selection" Click="Focus_Click"/></MenuItem><MenuItem Header="_Help"><MenuItem Header="_About" Click="About_Click"/></MenuItem>
    </Menu>
    <ToolBar DockPanel.Dock="Top">
      <Button Content="Select" Click="SelectMode_Click"/><Button Content="Move" Click="MoveMode_Click"/><Button Content="Rotate" Click="RotateMode_Click"/><Button Content="Scale" Click="ScaleMode_Click"/><Separator/>
      <Button Content="Duplicate" Click="Duplicate_Click"/><Button Content="Stamp" Click="Stamp_Click"/><Button Content="Delete" Click="Delete_Click"/><Separator/>
      <Button Content="Focus" Click="Focus_Click"/><Button Content="Undo" Click="Undo_Click"/><Button Content="Redo" Click="Redo_Click"/>
    </ToolBar>
    <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="StatusText" Text="Ready"/><Separator/><TextBlock x:Name="CoordText" Text="EQ X 0.00  Y 0.00  Z 0.00"/></StatusBar>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="220"/></Grid.RowDefinitions>
      <TabControl Grid.Column="0" Grid.RowSpan="3"><TabItem Header="Scene / Zone"><DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="EverQuest Folder..." Click="ChooseEqRoot_Click"/><Button Content="Refresh Zones" Click="OpenZone_Click"/><TextBlock x:Name="ZoneText" Margin="6" Text="No zone loaded"/></StackPanel><TreeView x:Name="SceneTree"/></DockPanel></TabItem><TabItem Header="EQ Asset Browser"><TreeView x:Name="AssetTree"/></TabItem></TabControl>
      <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch"/>
      <Border Grid.Column="2" Background="#080A0D" BorderBrush="#6930A8" BorderThickness="1"><wv2:WebView2 x:Name="Viewport"/></Border>
      <GridSplitter Grid.Column="3" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch"/>
      <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions><GroupBox Header="Inspector"><ScrollViewer><StackPanel x:Name="InspectorPanel"/></ScrollViewer></GroupBox><GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/><TabControl Grid.Row="2"><TabItem Header="Model"><wv2:WebView2 x:Name="ModelViewer"/></TabItem><TabItem Header="Object"><ListBox x:Name="ObjectList" SelectionChanged="ObjectList_SelectionChanged"/></TabItem><TabItem Header="Texture"><ListBox x:Name="TextureList"/></TabItem><TabItem Header="Material"><ListBox x:Name="MaterialList"/></TabItem></TabControl></Grid>
      <GridSplitter Grid.Column="2" Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
      <TabControl Grid.Column="2" Grid.Row="2"><TabItem Header="Status"/><TabItem Header="Difference"/><TabItem Header="Diagnostics"/><TabItem Header="Native Data"/><TabItem Header="Changes"/><TabItem Header="Console"/></TabControl>
    </Grid>
  </DockPanel>
</Window>
