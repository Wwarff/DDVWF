<Window x:Class="DDVWF.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="Dragon's Den Visual WorldForge | INTEGRATION" Width="1600" Height="1000" Background="#080B0A" Foreground="#00FF33" FontFamily="Verdana" FontSize="12">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#101311"/><SolidColorBrush x:Key="ControlBrush" Color="#171A18"/><SolidColorBrush x:Key="AccentBrush" Color="#00FF33"/><SolidColorBrush x:Key="SeparatorBrush" Color="#6A00A8"/>
    <Style TargetType="Menu"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Style>
    <Style TargetType="ToolBar"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource ControlBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/><Setter Property="Padding" Value="5,2"/><Setter Property="Margin" Value="1"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/></Style>
    <Style TargetType="TabItem"><Setter Property="Background" Value="{StaticResource ControlBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Style>
    <Style TargetType="TreeView"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SeparatorBrush}"/></Style>
    <Style TargetType="StatusBar"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Style>
    <Style TargetType="GridSplitter"><Setter Property="Background" Value="{StaticResource SeparatorBrush}"/></Style>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File"><MenuItem Header="_Open Zone..." Click="OpenZone_Click"/><MenuItem Header="_Close Zone" Click="CloseZone_Click"/><Separator/><MenuItem Header="EQEmu _SQL..." Click="ServerSettings_Click"/><Separator/><MenuItem Header="E_xit" Click="Exit_Click"/></MenuItem>
      <MenuItem Header="_Edit"><MenuItem Header="_Undo" Click="Undo_Click"/><MenuItem Header="_Redo" Click="Redo_Click"/></MenuItem>
      <MenuItem Header="_View"><MenuItem Header="_Compass" Click="Compass_Click"/><Separator/><MenuItem Header="_Theme Editor" Click="ThemeEditor_Click"/><MenuItem Header="_Shortcuts" Click="Shortcuts_Click"/></MenuItem>
      <MenuItem Header="_Tools"><MenuItem Header="_Focus Selection" Click="Focus_Click"/></MenuItem><MenuItem Header="_World"><MenuItem Header="_Reload Active Zone" Click="ReloadZone_Click"/></MenuItem><MenuItem Header="_Navigation"><MenuItem Header="_Focus Selection" Click="Focus_Click"/></MenuItem><MenuItem Header="_Help"><MenuItem Header="_About" Click="About_Click"/></MenuItem>
    </Menu>
    <ToolBar DockPanel.Dock="Top">
      <Button Content="Select" Click="SelectMode_Click"/><Button Content="Move" Click="MoveMode_Click"/><Button Content="Rotate" Click="RotateMode_Click"/><Button Content="Scale" Click="ScaleMode_Click"/><Separator/>
      <Button Content="Duplicate" Click="Duplicate_Click"/><Button Content="Stamp" Click="Stamp_Click"/><Button Content="Delete" Click="Delete_Click"/><Separator/>
      <Button Content="Focus" Click="Focus_Click"/><Button Content="Undo" Click="Undo_Click"/><Button Content="Redo" Click="Redo_Click"/>
    </ToolBar>
    <StatusBar DockPanel.Dock="Bottom"><TextBlock x:Name="StatusText" Text="Ready"/><Separator/><TextBlock x:Name="CoordText" Text="EQ X 0.00  Y 0.00  Z 0.00"/></StatusBar>
    <Grid Background="{StaticResource PanelBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="2"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="2"/><RowDefinition Height="220"/></Grid.RowDefinitions>
      <Grid Grid.Column="0" Grid.RowSpan="3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="2"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <GroupBox Header="SCENE / ZONE"><DockPanel><StackPanel DockPanel.Dock="Top"><Button Content="EverQuest Folder..." Click="ChooseEqRoot_Click"/><Button Content="Refresh Zones" Click="OpenZone_Click"/><TextBlock x:Name="ZoneText" Margin="6" Text="No zone loaded"/></StackPanel><TreeView x:Name="SceneTree"/></DockPanel></GroupBox>
        <GridSplitter Grid.Row="1" Height="2" HorizontalAlignment="Stretch"/>
        <GroupBox Grid.Row="2" Header="EQ ASSET BROWSER"><TreeView x:Name="AssetTree"/></GroupBox>
      </Grid>
      <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="2" HorizontalAlignment="Stretch"/>
      <Border Grid.Column="2" Background="#080A0D" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="1"><wv2:WebView2 x:Name="Viewport"/></Border>
      <GridSplitter Grid.Column="3" Grid.RowSpan="3" Width="2" HorizontalAlignment="Stretch"/>
      <Grid Grid.Column="4" Grid.RowSpan="3"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="2"/><RowDefinition Height="*"/></Grid.RowDefinitions><GroupBox Header="TEXTURE / MATERIAL"><TabControl><TabItem Header="TEXTURE"><ListBox x:Name="TextureList"/></TabItem><TabItem Header="MATERIAL"><ListBox x:Name="MaterialList"/></TabItem></TabControl></GroupBox><GridSplitter Grid.Row="1" Height="2" HorizontalAlignment="Stretch"/><GroupBox Grid.Row="2" Header="MODEL / OBJECT VIEWER"><TabControl><TabItem Header="MODEL"><wv2:WebView2 x:Name="ModelViewer"/></TabItem><TabItem Header="OBJECT"><ListBox x:Name="ObjectList" SelectionChanged="ObjectList_SelectionChanged"/></TabItem></TabControl></GroupBox></Grid>
      <GridSplitter Grid.Column="2" Grid.Row="1" Height="2" HorizontalAlignment="Stretch"/>
      <TabControl Grid.Column="2" Grid.Row="2"><TabItem Header="Status"/><TabItem Header="Difference"/><TabItem Header="Diagnostics"/><TabItem Header="Native Data"/><TabItem Header="Changes"/><TabItem Header="Console"/></TabControl>
    </Grid>
  </DockPanel>
</Window>